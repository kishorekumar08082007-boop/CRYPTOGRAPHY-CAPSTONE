# Flask Configuration
FLASK_SECRET_KEY=your-very-long-random-secret-key-here-change-this
FLASK_DEBUG=True

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_root_password
DB_NAME=digital_signature_system

# Encryption key for private key storage (32-byte base64-encoded key)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PRIVATE_KEY_ENCRYPTION_KEY=your-fernet-key-here

# File Upload Configuration
MAX_CONTENT_LENGTH=16777216
UPLOAD_FOLDER=uploads
CERTIFICATES_FOLDER=certificates
KEYS_FOLDER=keys

# Admin Default Credentials (change after first run)
ADMIN_EMAIL=admin@localdemo.test
ADMIN_PASSWORD=Admin@123
